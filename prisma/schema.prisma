// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:dev.db"
}

generator client {
  provider        = "prisma-client-js"
}

model User {
  telegramId      Int       @id
  name            String
  createdAt       DateTime  @default(now())

  //stats
  gymTimesNotified      Int      @default(0)
  locationTimesNotified Int      @default(0)
  /// Last time the user sent the bot anything; bumped by trackLastActivity in src/utils/lastActivity.ts
  lastActivity          DateTime @default(now())
  /// Last pin the user sent (any location message); used to sort gym/location lists by distance
  lastLat               Float?
  lastLong              Float?
  lastLocationAt        DateTime?

  //notify settings
  raidLevelNotify      String
  stopNotifyingMeToday DateTime?
  raidAlertMinutes     Int       @default(5)

  //f keys
  GymSubscribe      GymSubscribe[]
  LocationSubscribe LocationSubscribe[]
  NotifyWindow      NotifyWindow[]
}

model Gym {
  id           String         @id @default(uuid())
  geoKey       String?        @unique
  gymString    String?
  lat          Float
  long         Float
  lastRaidAt   DateTime?      // When we last saw a raid at this gym (for staleness cleanup)
  GymSubscribe GymSubscribe[]
  NotifyWindow NotifyWindow[]
}

/// A recurring notification window for one user.
/// Each row says: on these weekdays, between these clock times (Singapore time),
/// either ALLOW or BLOCK notifications — optionally only for one gym and/or one kind.
/// A user with no windows is notified at any time. Evaluation: src/utils/notifyWindows.ts
model NotifyWindow {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userTelegramId], references: [telegramId], onDelete: Cascade)
  userTelegramId Int

  /// "ALLOW": notify only inside this window.  "BLOCK": never notify inside this window.
  mode           String
  /// Which notifications it affects: "ALL", "RAID" (gym raids) or "PERFECT" (perfect/legendary spawns)
  notifyKind     String   @default("ALL")
  /// Only apply to this gym. NULL = every gym. A gym with its own windows ignores the user's global windows.
  gym            Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId          String?
  /// ISO weekdays the window is active on, comma-separated: 1=Mon … 7=Sun. "1,2,3,4,5" = weekdays
  weekdays       String
  /// Clock time the window starts, 24h "HH:MM" in Singapore time, inclusive
  startTime      String
  /// Clock time the window ends, "HH:MM", exclusive. If endTime <= startTime the window wraps past midnight ("22:00"–"06:00")
  endTime        String
  createdAt      DateTime @default(now())
}

model GymSubscribe {
  subscriber     User       @relation(fields: [userTelegramId], references: [telegramId])
  userTelegramId Int
  gym            Gym        @relation(fields: [gymId], references: [id])
  gymId          String
  GymEvent       GymEvent[]

  @@id([userTelegramId, gymId])
}

model GymEvent {
  eventTime                  DateTime
  gymSubscribe               GymSubscribe @relation(fields: [gymSubscribeUserTelegramId, gymSubscribeGymId], references: [userTelegramId, gymId], onDelete: Cascade)
  gymSubscribeUserTelegramId Int
  gymSubscribeGymId          String

  @@id([eventTime, gymSubscribeGymId, gymSubscribeUserTelegramId])
}

model LocationSubscribe {
  locationId     String          @id @default(uuid())
  subscriber     User            @relation(fields: [userTelegramId], references: [telegramId])
  userTelegramId Int
  lat            Float
  long           Float
  /// Notify radius around the pin in metres (great-circle distance, see src/utils/geo.ts)
  radiusMeters   Float           @default(100)
  LocationEvent  LocationEvent[]
}

model LocationEvent {
  locationSubscribe           LocationSubscribe @relation(fields: [locationSubscribeLocationId], references: [locationId], onDelete: Cascade)
  locationSubscribeLocationId String
  lat                         Float
  long                        Float
  eventTime                   DateTime

  @@id([locationSubscribeLocationId, eventTime])
}
